@using ASP_NET_Core.Models

@(Html.DevExtreme().DataGrid<Product>()
    .ShowBorders(true)
    .DataSource(ds => ds.OData()
        .Version(4)
        .Url("/odata/Products")
        .Key("Product_ID")
    )
    .DataSourceOptions(dso => dso
        .Select(new [] {
            "Product_ID",
            "Product_Name",
            "Product_Production_Start",
            "Product_Cost",
            "Product_Sale_Price",
            "Product_Retail_Price",
            "Product_Current_Inventory"
        })
        .Filter("['Product_Current_Inventory', '>' , 0]")
    )
    .Columns(columns => {
        columns.AddFor(m => m.Product_ID);

        columns.AddFor(m => m.Product_Name)
            .Width(250);

        columns.AddFor(m => m.Product_Production_Start)
            .Caption("Production Start")
            .DataType(GridColumnDataType.DateTime);

        columns.AddFor(m => m.Product_Cost)
            .Caption("Cost")
            .DataType(GridColumnDataType.Number)
            .Format(Format.Currency);

        columns.AddFor(m => m.Product_Sale_Price)
            .Caption("Sale Price")
            .DataType(GridColumnDataType.Number)
            .Format(Format.Currency);

        columns.AddFor(m => m.Product_Retail_Price)
            .Caption("Retail Price")
            .DataType(GridColumnDataType.Number)
            .Format(Format.Currency);

        columns.AddFor(m => m.Product_Current_Inventory)
            .Caption("Inventory");
    })
)
